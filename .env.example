# Token del bot (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=

# Porta dell'API del bot (FiveM e sito). In locale 3001, perché il sito usa la 3000.
# Su Railway non serve: Railway imposta da solo la variabile PORT.
API_PORT=3001

# Chiave segreta condivisa con la risorsa FiveM (deve essere uguale a "literp_discord_secret" nel server.cfg)
# Usa una stringa lunga e casuale!
API_SECRET=cambia_questa_chiave_segreta

# ===== Collegamento con il sito =====
# Chiave che il sito usa per leggere i dati del bot (uguale a BOT_API_SECRET del sito)
SITE_API_SECRET=
# Indirizzo del sito, senza "/" finale. http://localhost:3000 funziona solo se anche il bot gira sul tuo PC.
# Con il bot su Railway serve l'indirizzo pubblico (Vercel). Vuoto = il sito si aggiorna da solo ogni minuto.
SITE_URL=
# Chiave che il bot usa per dire al sito di aggiornarsi (uguale a REVALIDATE_SECRET del sito)
REVALIDATE_SECRET=

# Cartella dove salvare database e immagini (vuoto = ./data).
# Su Railway: il percorso del Volume, es. /data
DATA_DIR=

# true = il bot vede chi è online (staff in servizio sul sito).
# Prima attiva "PRESENCE INTENT" nel Developer Portal -> Bot, altrimenti il bot non si collega.
PRESENCE_INTENT=false
